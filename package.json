{
  "name": "ethproxy",
  "version": "0.1.0",
  "description": "A reverse proxy for Ethereum JSON-RPC with multi-upstream failover, sync-aware health checks and tiered caching",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5",
    "ioredis": "^5.4.1",
    "lru-cache": "^11.5.3",
    "prom-client": "^15.1.3",
    "undici": "^8.11.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "ioredis-mock": "^8.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^2.0.4"
  }
}

{
  "name": "ethproxy",
  "version": "0.1.0",
  "description": "A reverse proxy for Ethereum JSON-RPC with multi-upstream failover, sync-aware health checks and tiered caching",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "lru-cache": "^11.0.0",
    "prom-client": "^15.1.3",
    "undici": "^6.19.7",
    "ws": "^8.21.3",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "ioredis-mock": "^8.9.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.4"
  }
}
